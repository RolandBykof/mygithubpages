{
  "manifest_version": 3,
  "name": "Funbridge testipaja",
  "version": "1.3",
  "description": "screen reader support for Funbridge – keyboard navigation, card reading, bidding and card play.",
  "icons": {
    "16":  "icon16.png",
    "48":  "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://play.funbridge.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://play.funbridge.com/*"],
      "js": ["fb-library-bridge.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fb-library-bridge.js"],
      "matches": ["*://play.funbridge.com/*"]
    }
  ],
  "permissions": []
}
